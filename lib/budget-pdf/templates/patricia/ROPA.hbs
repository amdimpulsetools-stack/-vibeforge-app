{{!--
  Yenda · Presupuesto Dra. Patricia Quispe — MÉTODO ROPA
  Fuente: …/PRESUPUESTO ROPA.docx
  Datos: lib/budget-pdf/patricia/data/ropa.ts  ·  Total S/ 21,200

  Una integrante de la pareja aporta los óvulos (ciclo FIV completo) y
  la otra gesta (transferencia). Se usa semen donado, cuyo costo va
  aparte del total.

  El subtotal del bloque de la donante se corrigió de S/ 17,000 (lo que
  decía el .docx) a S/ 17,200 (suma real de los ítems); el TOTAL del
  original ya estaba calculado sobre 17,200 y no cambia. Ver el data
  file.
--}}
{{> head}}

  <!-- ============== PÁGINA 1 ============================== -->
  <section class="sheet" data-screen-label="01">
    <div class="sheet-body">
{{> sheetHead}}
{{> titleRow}}
{{> meta}}

      <section class="phases">
        <div class="phase">
          <div class="phase-head">
            <div class="phase-num">1</div>
            <div class="phase-name">Fecundación in Vitro · donante de óvulos</div>
            <div class="phase-sub"><small>Subtotal</small>S/ {{phases.donante.subtotal}}</div>
          </div>
          <table class="items">
            <tbody>
              <tr>
                <td class="desc">Consulta médica y controles ovulatorios</td>
                <td class="amt"><span class="cur">S/</span> {{phases.donante.consulta}}</td>
              </tr>
              <tr>
                <td class="desc">Medicación hormonal para estimulación ovárica
                  <span class="hint">Costo aproximado</span></td>
                <td class="amt"><span class="cur">S/</span> {{phases.donante.medicacion}}</td>
              </tr>
              <tr>
                <td class="desc">Honorarios médicos
                  <span class="hint">Pago en efectivo o transferencia bancaria</span></td>
                <td class="amt"><span class="cur">S/</span> {{phases.donante.honorarios}}</td>
              </tr>
              <tr>
                <td class="desc">Aspiración folicular + procedimiento de FIV-ICSI</td>
                <td class="amt"><span class="cur">S/</span> {{phases.donante.aspiracion_fiv}}</td>
              </tr>
              <tr>
                <td class="desc">Vitrificación de embriones</td>
                <td class="amt"><span class="cur">S/</span> {{phases.donante.vitrificacion}}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="phase">
          <div class="phase-head">
            <div class="phase-num">2</div>
            <div class="phase-name">Transferencia embrionaria · receptora</div>
            <div class="phase-sub"><small>Subtotal</small>S/ {{phases.receptora.subtotal}}</div>
          </div>
          <table class="items">
            <tbody>
              <tr>
                <td class="desc">Honorarios médicos
                  <span class="hint">Pago en efectivo o transferencia bancaria</span></td>
                <td class="amt"><span class="cur">S/</span> {{phases.receptora.honorarios}}</td>
              </tr>
              <tr>
                <td class="desc">Control endometrial, desvitrificación de embriones y transferencia embrionaria</td>
                <td class="amt"><span class="cur">S/</span> {{phases.receptora.control_endometrial}}</td>
              </tr>
            </tbody>
          </table>
        </div>

{{> total}}
      </section>

{{> semenDonado}}

    </div>
{{> pageFooter}}
  </section>

  <!-- ============== PÁGINA 2 ============================== -->
  <section class="sheet" data-screen-label="02">
    <div class="sheet-body">
{{> runHead}}
{{> consideracionesEmbriones}}
{{> ngs}}
    </div>
{{> pageFooter}}
  </section>

  <!-- ============== PÁGINA 3 ============================== -->
  <section class="sheet" data-screen-label="03">
    <div class="sheet-body">
{{> runHead}}
{{> evaluaciones mujerCompleta=true hombre=true}}
{{> terminos}}
{{> firmas}}
    </div>
{{> pageFooter}}
  </section>

{{> docEnd}}
