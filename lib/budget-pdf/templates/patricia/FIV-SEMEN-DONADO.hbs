{{!--
  Yenda · Presupuesto Dra. Patricia Quispe — FIV CON SEMEN DONADO
  Fuente: …/PRESUPUESTO DE FIV CON SEMEN DONADO.docx
  Datos: lib/budget-pdf/patricia/data/fiv-semen-donado.ts  ·  Total S/ 21,000

  Mismos importes que el FIV estándar; añade el bloque informativo de
  semen donado (fuera del total) y omite la columna del varón en las
  evaluaciones previas — la muestra es de donante.

  Variables: org.* · doc.title · patient.* · doctor.* · advisor.* ·
  budget.{code, issued_at_short, valid_until_short, total_formatted} ·
  phases.{fiv, transferencia} · semen.* · ngs.* · extras.*
--}}
{{> head}}

  <!-- ============== PÁGINA 1 ============================== -->
  <section class="sheet" data-screen-label="01">
    <div class="sheet-body">
{{> sheetHead}}
{{> titleRow}}
{{> meta}}

      <section class="phases">
        <div class="phase">
          <div class="phase-head">
            <div class="phase-num">1</div>
            <div class="phase-name">Fecundación in Vitro</div>
            <div class="phase-sub"><small>Subtotal</small>S/ {{phases.fiv.subtotal}}</div>
          </div>
          <table class="items">
            <tbody>
              <tr>
                <td class="desc">Consulta médica y controles ovulatorios</td>
                <td class="amt"><span class="cur">S/</span> {{phases.fiv.consulta}}</td>
              </tr>
              <tr>
                <td class="desc">Medicación hormonal para estimulación ovárica
                  <span class="hint">Costo aproximado</span></td>
                <td class="amt"><span class="cur">S/</span> {{phases.fiv.medicacion}}</td>
              </tr>
              <tr>
                <td class="desc">Honorarios médicos
                  <span class="hint">Pago en efectivo o transferencia bancaria</span></td>
                <td class="amt"><span class="cur">S/</span> {{phases.fiv.honorarios}}</td>
              </tr>
              <tr>
                <td class="desc">Aspiración folicular + procedimiento de FIV-ICSI</td>
                <td class="amt"><span class="cur">S/</span> {{phases.fiv.aspiracion_fiv}}</td>
              </tr>
              <tr>
                <td class="desc">Vitrificación de embriones</td>
                <td class="amt"><span class="cur">S/</span> {{phases.fiv.vitrificacion}}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="phase">
          <div class="phase-head">
            <div class="phase-num">2</div>
            <div class="phase-name">Transferencia embrionaria</div>
            <div class="phase-sub"><small>Subtotal</small>S/ {{phases.transferencia.subtotal}}</div>
          </div>
          <table class="items">
            <tbody>
              <tr>
                <td class="desc">Honorarios médicos
                  <span class="hint">Pago en efectivo o transferencia bancaria</span></td>
                <td class="amt"><span class="cur">S/</span> {{phases.transferencia.honorarios}}</td>
              </tr>
              <tr>
                <td class="desc">Control endometrial, desvitrificación de embriones y transferencia embrionaria</td>
                <td class="amt"><span class="cur">S/</span> {{phases.transferencia.control_endometrial}}</td>
              </tr>
            </tbody>
          </table>
        </div>

{{> total}}
      </section>

{{> semenDonado}}

    </div>
{{> pageFooter}}
  </section>

  <!-- ============== PÁGINA 2 ============================== -->
  <section class="sheet" data-screen-label="02">
    <div class="sheet-body">
{{> runHead}}
{{> consideracionesEmbriones}}
{{> ngs}}
    </div>
{{> pageFooter}}
  </section>

  <!-- ============== PÁGINA 3 ============================== -->
  <section class="sheet" data-screen-label="03">
    <div class="sheet-body">
{{> runHead}}
{{> evaluaciones mujerCompleta=true}}
{{> terminos}}
{{> firmas}}
    </div>
{{> pageFooter}}
  </section>

{{> docEnd}}
